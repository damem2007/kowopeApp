# Gmail: smtp.gmail.com / 587 / false
# Outlook: smtp.office365.com / 587 / false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
INVOICE_FROM=your-email@example.com
BUSINESS_NAME=Your Business Name
VAULT_KEY=replace-with-a-long-random-vault-key
KOWOPE_OWNER_EMAIL=owner@example.com
KOWOPE_OWNER_PASSWORD=replace-with-a-password-of-at-least-12-characters
PUBLIC_APP_URL=http://localhost:5173
DATABASE_CLIENT=sqlite
# Set this same secret on the Render Web Service and Render Cron Job.
CRON_SECRET=replace-with-your-render-cron-secret
# Required only when DATABASE_CLIENT=postgres. PostgreSQL support requires the
# async repository migration described in server/db/adapter.js.
# DATABASE_URL=postgresql://user:password@host:5432/kowope
# Optional absolute path when using SQLite. Render should set this to the
# persistent-disk location, for example /opt/render/project/src/data/invoices.db.
# SQLITE_DATABASE_PATH=/opt/render/project/src/data/invoices.db
